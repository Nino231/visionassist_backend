# Normalise line endings to LF in the repo; checkout converts to CRLF on Windows.
* text=auto eol=lf

# Force LF for shell scripts and YAML even on Windows.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# JSON and Markdown
*.json  text eol=lf
*.md    text eol=lf

# Python
*.py    text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
