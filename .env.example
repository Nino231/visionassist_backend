# ---------------------------------------------------------------------------
# VisionAssist Backend — environment variable template
# Copy to .env (git-ignored) and fill in real values.
# ---------------------------------------------------------------------------

# --- Proxy authentication ---
# Shared secret that the Flutter app sends as the X-API-Key request header.
# Generate a strong random string for any non-demo deployment.
# Note: for production, replace with per-device keys or OAuth 2.0.
PROXY_API_KEY=change-me-strong-random-secret

# --- Langflow connection ---
# Base URL of the Langflow service (internal Docker name in compose, or external URL).
LANGFLOW_BASE_URL=http://langflow:7860

# Flow IDs — copy from the Langflow UI after importing the JSON files in flows/.
LANGFLOW_FLOW_ID_QA=00000000-0000-0000-0000-000000000001
LANGFLOW_FLOW_ID_INGREDIENT=00000000-0000-0000-0000-000000000002

# Timeout (seconds) for each outbound Langflow request.
LANGFLOW_TIMEOUT=15

# --- LLM provider selection ---
# Supported values: watsonx | openai | ollama
MODEL_PROVIDER=watsonx

# --- watsonx.ai credentials (used when MODEL_PROVIDER=watsonx) ---
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# --- OpenAI credentials (used when MODEL_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_ID=gpt-4o-mini

# --- Ollama (used when MODEL_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_ID=llama3

# --- Safety / grounding ---
# Jaccard overlap threshold below which a Q&A answer is treated as ungrounded.
# Range 0.0–1.0; default 0.3.
GROUNDING_MIN_OVERLAP=0.3

# --- Rate limiting ---
# Max requests per API key per minute (in-memory; Redis optional — see README).
RATE_LIMIT_PER_MINUTE=60

# --- App settings ---
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
